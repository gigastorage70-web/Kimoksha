                "html": "<div style='background:#FFFFFF; border:1px solid #E5E7EB; border-radius:18px; padding:36px; box-shadow:0 4px 16px rgba(26,26,46,0.04);'>\n      <div style='display:grid; grid-template-columns:1.2fr 0.8fr; gap:36px; align-items:center;'>\n        <div>\n          <h3 style='font-size:24px; margin-bottom:12px;'>Wholesale SMS Termination & Hubbing</h3>\n          <p style='color:#5A6370; font-size:14.5px; line-height:1.65; margin-bottom:16px;'>Direct bilateral carrier interconnects connecting 500+ mobile networks worldwide with dynamic Least-Cost Routing and guaranteed DLR reporting.</p>\n          <ul style='list-style:none; padding:0; font-size:14px; color:#1A1A2E;'>\n            <li style='margin-bottom:8px;'>\u2713 Direct SS7 / SIGTRAN operator binds</li>\n            <li style='margin-bottom:8px;'>\u2713 Guaranteed alphanumeric sender ID preservation</li>\n            <li>\u2713 Multi-currency billing (USD, EUR, AED, GBP)</li>\n          </ul>\n        </div>\n        <div style='background:#F8F9FB; border:1px solid #E5E7EB; border-radius:14px; padding:28px; text-align:center;'>\n          <div style='font-size:40px; font-weight:800; color:#F26522;'>200+</div>\n          <div style='font-size:13.5px; color:#5A6370; font-weight:600;'>Countries Terminated Directly</div>\n        </div>\n      </div>\n    </div>"
