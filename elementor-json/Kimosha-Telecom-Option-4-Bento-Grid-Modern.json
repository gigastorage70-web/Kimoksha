                  "elements": []
                },
                {
                  "id": "54b2f89a",
                  "elType": "widget",
                  "isInner": false,
                  "widgetType": "text-editor",
                  "settings": {
                    "editor": "<p style='color:#5A6370; font-size:16px; line-height:1.65;'><div style='text-align:center;'>A balanced mosaic of wholesale termination, enterprise messaging, and carrier infrastructure.</div></p>"
                  },
                  "elements": []
                }
              ]
            },
            {
              "id": "5877243e",
              "elType": "widget",
              "isInner": false,
              "widgetType": "html",
              "settings": {
                "html": "<div style='display:grid; grid-template-columns:1.3fr 0.7fr 1fr; gap:20px;'>\n      <div style='grid-column:1 / span 2; background:#FFFFFF; border:1px solid #E5E7EB; border-top:4px solid #F26522; border-radius:16px; padding:28px; box-shadow:0 2px 8px rgba(26,26,46,0.04);'>\n        <span style='font-family:monospace; font-size:11px; font-weight:700; color:#A8420E; background:#FFF3EB; padding:2px 8px; border-radius:4px;'>01 / A2P TERMINATION</span>\n        <h3 style='font-size:22px; margin:8px 0;'>Wholesale SMS Termination</h3>\n        <p style='color:#5A6370; font-size:14px;'>Direct operator routes across 200+ countries with dynamic LCR, CLI preservation, and real-time handset SS7 delivery receipts.</p>\n      </div>\n      <div style='grid-column:3; grid-row:1 / span 2; background:#FEFCFA; border:1px solid #E5E7EB; border-top:4px solid #F26522; border-radius:16px; padding:28px; box-shadow:0 2px 8px rgba(26,26,46,0.04);'>\n        <span style='font-family:monospace; font-size:11px; font-weight:700; color:#A8420E; background:#FFF3EB; padding:2px 8px; border-radius:4px;'>02 / SIP VOICE</span>\n        <h3 style='font-size:22px; margin:8px 0;'>Wholesale Voice Termination</h3>\n        <p style='color:#5A6370; font-size:14px;'>Crystal-clear voice routes with guaranteed CLI pass-through, low Post-Dial Delay (PDD &lt; 1.5s), and global SBCs.</p>\n        <div style='margin-top:20px; background:#FFF; border:1px solid #E5E7EB; padding:12px; border-radius:8px; font-size:12px; color:#5A6370;'><strong>Codecs:</strong> G.711a, G.711u, G.729, Opus HD</div>\n      </div>\n      <div style='grid-column:1; background:#FFFFFF; border:1px solid #E5E7EB; border-top:4px solid #F26522; border-radius:16px; padding:24px;'>\n        <span style='font-family:monospace; font-size:11px; font-weight:700; color:#A8420E;'>03 / OTP</span>\n        <h4 style='font-size:18px; margin:6px 0;'>A2P Messaging & OTP</h4>\n        <p style='color:#5A6370; font-size:13.5px;'>High-priority queues for 2FA verification codes.</p>\n      </div>\n      <div style='grid-column:2; background:#FFFFFF; border:1px solid #E5E7EB; border-top:4px solid #F26522; border-radius:16px; padding:24px;'>\n        <span style='font-family:monospace; font-size:11px; font-weight:700; color:#A8420E;'>04 / PROTOCOL</span>\n        <h4 style='font-size:18px; margin:6px 0;'>SMPP 3.4 Binds</h4>\n        <p style='color:#5A6370; font-size:13.5px;'>High-throughput binary SMPP transceiver sessions.</p>\n      </div>\n    </div>"
              },
